---
import dayjs from "dayjs";

interface Props {
	time: Date;
	class?: string | null;
}
const { time } = Astro.props;

const parseTime = dayjs(time);
const dateDetail = parseTime.format("MMM, DD YYYY at HH:mm Z");
const displayDate = parseTime.format("DD/MM/YYYY");
---

<div class:list={["kz-tooltip", Astro.props.class]} data-tip={dateDetail}>
    <slot>{displayDate}</slot>
</div>
